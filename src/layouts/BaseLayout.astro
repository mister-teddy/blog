---
import "../styles/global.css";
import { absoluteBlogUrl, blogPath, SITE_DESCRIPTION, SITE_TITLE } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  lang?: string;
  initialLanguage?: string;
  mainClass?: string;
  theme?: "hanh-chinh" | "so-thich" | "pride";
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  canonicalPath = Astro.url.pathname,
  lang = "en",
  initialLanguage = lang,
  mainClass = "",
  theme = "so-thich",
} = Astro.props;
const pageTitle = title === SITE_TITLE ? SITE_TITLE : `${title} - ${SITE_TITLE}`;
const canonical = canonicalPath.startsWith("http")
  ? canonicalPath
  : absoluteBlogUrl(canonicalPath.replace(/^\/blog\/?/, ""));
---

<!doctype html>
<html lang={lang} data-initial-language={initialLanguage} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={absoluteBlogUrl("rss.xml")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400;1,700&family=IBM+Plex+Mono:ital,wght@0,400;0,700;1,400;1,700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Cormorant+Garamond:wght@400;500;600;700&family=Comfortaa:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8496762857844623"
      crossorigin="anonymous"></script>
    <slot name="head" />
  </head>
  <body>
    <div class="document-frame">
      <aside class="document-strip" aria-label="Blog identity">
        <a class="brand" href={blogPath()}>Blog</a>
        <a class="strip-number" href="https://github.com/mister-teddy" target="_blank" rel="noreferrer">MISTER TEDDY</a>
        <a class="machine-code" href="https://ko-fi.com/misterteddy" target="_blank" rel="noreferrer">BUY&lt;ME&lt;A&lt;&lt;COFEE</a>
        <nav class="nav" aria-label="Primary">
          <a href="/">Portfolio</a>
          <a href={blogPath("rss.xml")} target="_blank" rel="noreferrer">RSS</a>
        </nav>
      </aside>
      <main class={`document-main ${mainClass}`}>
        {
          theme === "so-thich" && (
            <div class="watch-deco" aria-hidden="true">
              <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <radialGradient id="osBezel" cx="34%" cy="26%" r="78%">
                    <stop offset="0%" stop-color="#fbfcfe" />
                    <stop offset="45%" stop-color="#d4dbe5" />
                    <stop offset="80%" stop-color="#aab4c2" />
                    <stop offset="100%" stop-color="#7f8a9b" />
                  </radialGradient>
                  <radialGradient id="osDial" cx="50%" cy="40%" r="65%">
                    <stop offset="0%" stop-color="#ffffff" />
                    <stop offset="60%" stop-color="#eef2f7" />
                    <stop offset="100%" stop-color="#dde4ed" />
                  </radialGradient>
                  <linearGradient id="osSky" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#cfe6fb" />
                    <stop offset="48%" stop-color="#8fbde6" />
                    <stop offset="52%" stop-color="#243456" />
                    <stop offset="100%" stop-color="#121a33" />
                  </linearGradient>
                  <linearGradient id="osHand" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0%" stop-color="#36589f" />
                    <stop offset="50%" stop-color="#1b337a" />
                    <stop offset="100%" stop-color="#0f2155" />
                  </linearGradient>
                  <rect id="osBat" x="196" y="40" width="8" height="22" rx="2" fill="#26324f" />
                </defs>

                <circle cx="200" cy="200" r="199" fill="#828d9d" />
                <circle cx="200" cy="200" r="196" fill="url(#osBezel)" />
                <circle cx="200" cy="200" r="183" fill="#b6bfcc" />
                <circle cx="200" cy="200" r="179" fill="url(#osDial)" />
                <g fill="none" stroke="#1a223a" stroke-opacity="0.04">
                  <circle cx="200" cy="200" r="150" />
                  <circle cx="200" cy="200" r="116" />
                  <circle cx="200" cy="200" r="82" />
                  <circle cx="200" cy="200" r="48" />
                </g>

                <circle cx="200" cy="200" r="168" fill="none" stroke="#7c8696" stroke-width="7" stroke-dasharray="1.5 16.09" transform="rotate(-0.26 200 200)" />

                <use href="#osBat" transform="rotate(30 200 200)" />
                <use href="#osBat" transform="rotate(60 200 200)" />
                <use href="#osBat" transform="rotate(90 200 200)" />
                <use href="#osBat" transform="rotate(120 200 200)" />
                <use href="#osBat" transform="rotate(150 200 200)" />
                <use href="#osBat" transform="rotate(210 200 200)" />
                <use href="#osBat" transform="rotate(240 200 200)" />
                <use href="#osBat" transform="rotate(300 200 200)" />
                <use href="#osBat" transform="rotate(330 200 200)" />

                <g fill="#26324f" font-family="Georgia, 'Times New Roman', serif" text-anchor="middle">
                  <text x="200" y="80" font-size="27">XII</text>
                  <text x="200" y="336" font-size="27">VI</text>
                </g>

                <g>
                  <circle cx="200" cy="128" r="33" fill="url(#osSky)" stroke="#aab4c2" stroke-width="2" />
                  <circle cx="200" cy="110" r="9" fill="none" stroke="#e6b13f" stroke-width="3" stroke-dasharray="1.2 3.5" />
                  <circle cx="200" cy="110" r="5" fill="#f0c14b" />
                  <circle cx="200" cy="110" r="2" fill="#ffe08a" />
                  <circle cx="201" cy="146" r="5" fill="#dfe6f5" />
                  <circle cx="203.5" cy="144.5" r="4" fill="#243456" />
                  <circle cx="190" cy="150" r="0.8" fill="#ffffff" />
                  <circle cx="212" cy="151" r="0.8" fill="#ffffff" />
                  <circle cx="207" cy="139" r="0.6" fill="#ffffff" />
                  <g id="osSunMoon">
                    <polygon points="200,104 202,128 200,138 198,128" fill="#16204a" />
                    <circle cx="200" cy="128" r="2.2" fill="#16204a" />
                  </g>
                </g>

                <g>
                  <circle cx="132" cy="196" r="28" fill="#e1e6ee" stroke="#aeb8c6" stroke-width="2" />
                  <circle cx="132" cy="196" r="22" fill="#eceff4" />
                  <circle cx="132" cy="196" r="16" fill="none" stroke="#aab4c2" stroke-width="3" />
                  <circle cx="132" cy="196" r="14" fill="none" stroke="#c2a14e" stroke-width="1.5" />
                  <circle cx="132" cy="196" r="7.5" fill="none" stroke="#9aa6cf" stroke-width="1" />
                  <line x1="132" y1="180" x2="132" y2="212" stroke="#aab4c2" stroke-width="1.1" />
                  <line x1="116" y1="196" x2="148" y2="196" stroke="#aab4c2" stroke-width="1.1" />
                  <circle cx="139" cy="189" r="2" fill="#b04a4a" />
                </g>

                <g>
                  <circle cx="200" cy="272" r="27" fill="#eef2f7" stroke="#b4bdca" stroke-width="1.5" />
                  <circle cx="200" cy="272" r="22" fill="none" stroke="#8b94a3" stroke-width="4" stroke-dasharray="1 10.5" />
                  <g id="osSecond">
                    <line x1="200" y1="253" x2="200" y2="281" stroke="#21408f" stroke-width="1.5" stroke-linecap="round" />
                  </g>
                  <circle cx="200" cy="272" r="2.2" fill="#1b2f6b" />
                </g>

                <g font-family="Georgia, 'Times New Roman', serif" text-anchor="middle" fill="#4a5568">
                  <text x="236" y="210" font-size="11" letter-spacing="1.4">ORIENT STAR</text>
                  <text x="252" y="229" font-size="7" letter-spacing="1" fill="#7a8494">AUTOMATIC</text>
                </g>

                <g id="osHour">
                  <polygon points="200,122 205,160 200,206 195,160" fill="url(#osHand)" />
                  <polygon points="200,122 205,160 200,206" fill="#3a5cc0" opacity="0.55" />
                </g>
                <g id="osMinute">
                  <polygon points="200,90 203.5,150 200,208 196.5,150" fill="url(#osHand)" />
                  <polygon points="200,90 203.5,150 200,208" fill="#3a5cc0" opacity="0.55" />
                </g>
                <circle cx="200" cy="200" r="8" fill="#16204a" />
                <circle cx="200" cy="200" r="3.4" fill="#3a5cc0" />

                <ellipse cx="150" cy="138" rx="118" ry="86" fill="#ffffff" opacity="0.06" />
              </svg>
            </div>
          )
        }
        <div class="document-content">
          <slot />
        </div>
      </main>
    </div>
    <script is:inline>
      (function () {
        if (!document.querySelector(".watch-deco svg")) return;
        const rot = (id, deg, cx, cy) => {
          const el = document.getElementById(id);
          if (el) el.setAttribute("transform", "rotate(" + deg + " " + cx + " " + cy + ")");
        };
        function tick() {
          const n = new Date();
          const s = n.getSeconds() + n.getMilliseconds() / 1000;
          const m = n.getMinutes() + s / 60;
          const h = (n.getHours() % 12) + m / 60;
          const h24 = n.getHours() + m / 60;
          rot("osHour", h * 30, 200, 200);
          rot("osMinute", m * 6, 200, 200);
          rot("osSecond", s * 6, 200, 272);
          rot("osSunMoon", (h24 - 12) * 15, 200, 128);
        }
        tick();
        setInterval(tick, 1000);
      })();
    </script>
  </body>
</html>
