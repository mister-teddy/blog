---
import ProseImage from "./ProseImage.astro";

interface Props {
  images: { src: string; alt?: string }[];
}
const { images } = Astro.props;
---

<div class="gallery">
  {images.map((img) => <ProseImage src={img.src} alt={img.alt} />)}
</div>

<style>
  /* ponytail: CSS multicol is native masonry; column count auto-fits to width. */
  .gallery {
    columns: 16rem;
    gap: 0.6rem;
    margin: 1.1em 0;
  }

  .gallery :global(.prose-image-button) {
    margin: 0 0 0.6rem;
    break-inside: avoid;
  }
</style>
